digraph wllama {
  // Render at 200 dpi; size limits the output to 2560x1440.
  graph [
    rankdir=TB,
    compound=true,
    fontname="Helvetica",
    fontsize=11,
    nodesep=0.26,
    ranksep=0.36,
    pad=0.15,
    bgcolor="white",
    dpi=200,
    size="12.8,7.2"
  ];
  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#EEF2FF",
    color="#6366F1",
    fontname="Helvetica",
    fontsize=10,
    margin="0.10,0.06",
    width=4.0,
    height=0.55,
    penwidth=1.0
  ];
  edge [
    color="#475569",
    fontname="Helvetica",
    fontsize=8.5,
    arrowsize=0.65,
    penwidth=1.0
  ];

  subgraph cluster_browser {
    label="Web Browser";
    fontsize=13;
    color="#9CA3AF";
    style="rounded,dashed";
    penwidth=1.2;

    subgraph cluster_app {
      label="Application";
      fontsize=10;
      color="#D1D5DB";
      style="rounded";
      UI [label="Web Application"];
    }

    subgraph cluster_api {
      label="wllama API layer";
      fontsize=10;
      color="#D1D5DB";
      style="rounded";
      WAPI [label="Wllama API\nload, chat, completion, embeddings, streaming", fillcolor="#FEE2E2", color="#F87171"];
      MM [label="Model manager\nshards, downloads, validation"];
      CM [label="Cache manager\nmetadata, integrity, storage policy"];
      HF [label="Hugging Face resolver\nrepo and file lookup"];
      GLUEJS [label="GLUE protocol\ntyped binary codec"];
    }

    PX [label="Main-thread orchestration\nWorker orchestrator, task queue, buffers"];

    subgraph cluster_worker {
      label="Internal Web Worker";
      fontsize=10;
      color="#D1D5DB";
      style="rounded";
      WORKER [label="Worker runtime\nmodule lifecycle, file bridge, WASM calls"];
    }

    subgraph cluster_wasm {
      label="wllama.wasm";
      fontsize=10;
      color="#D1D5DB";
      style="rounded";
      ABI [label="C ABI\nexports and action dispatch"];
      GLUECPP [label="GLUE protocol\nmessage parse and serialize"];
      CTX [label="Request context\nreaders, request IDs, cancellation"];
      LLAMA [label="llama.cpp + ggml core\nserver queue, chat, sampling\ninference, KV cache, multimodal", fillcolor="#FEE2E2", color="#F87171"];
    }

    subgraph cluster_platform {
      label="Browser platform";
      fontsize=10;
      color="#D1D5DB";
      style="rounded";
      CPU [label="CPU backend\nWASM SIMD + pthreads"];
      GPU [label="WebGPU backend\nggml-webgpu", fillcolor="#FEE2E2", color="#F87171"];
      ASYNC [label="Async runtime\nJSPI or Asyncify"];
      OPFS [label="OPFS / Cross-Origin Storage"];
    }
  }

  subgraph cluster_webserver {
    label="Webserver / CDN";
    fontsize=13;
    color="#9CA3AF";
    style="rounded,dashed";
    penwidth=1.2;

    MODELHOST [
      label="HTTP(S) GGUF downloads",
      fillcolor="#F3F4F6",
      color="#6B7280"
    ];
  }

  UI -> WAPI;
  WAPI -> MM;
  WAPI -> GLUEJS;
  MM -> CM;
  MM -> HF;
  CM -> OPFS [style=dashed, label="Cache"];
  CM -> MODELHOST [dir=both, label="Download"];
  GLUEJS -> PX [label="Actions"];
  PX -> WORKER [dir=both, label="PostMessage"];
  WORKER -> ABI;
  WORKER -> ASYNC;
  ABI -> GLUECPP;
  ABI -> CTX;
  CTX -> GLUECPP;
  CTX -> LLAMA;
  LLAMA -> CPU;
  LLAMA -> GPU;
}
